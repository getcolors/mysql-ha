# Managed by Colors mysql-ha. Non-secret node facts every agent reads.
# Credentials live in secrets.env, rclone.conf and binlog-client.cnf, none of
# which are ever rendered into the work directory.
NODE_NAME={{ inventory_hostname }}
NODE_ORDINAL={{ node_ordinal }}
NODE_HOST={{ node_host }}
PRIVATE_IP={{ private_ip }}
DROPLET_ID={{ droplet_id }}
SERVER_ID={{ server_id }}
CONNECTION_SERVER_ID={{ connection_server_id }}
MYSQL_PORT=3306
MYSQL_GROUP_PORT=33061
MYSQL_GROUP_NAME=9f8c1d7e-0e6a-4c2b-9a54-6f1b2c3d4e5f
CLUSTER_HOST=my-ha.fixture.example
RESERVED_IP=192.0.2.10
BACKUP_BUCKET=fixture-backup
BACKUP_PREFIX=mysql-ha-fixture
BACKUP_RETENTION_DAYS=14
BACKUP_RESTORE_MAX_LAG_SECONDS=900
