#!/usr/bin/env bash
# Managed by Colors mysql-ha — claim the client endpoint for this member.
#
# The endpoint is a DigitalOcean reserved IP, and the Cloudflare record that
# names it never changes. Failover therefore moves an address between droplets
# instead of moving a record between addresses, which is why OpenTofu can keep
# owning the DNS while the cluster owns the assignment.
#
# Runs on every member every <{ endpoint-poll-interval }>. All but the primary
# exit in the first three lines.
set -euo pipefail

# shellcheck source=/dev/null
. /usr/local/lib/mysql-ha-lib
# shellcheck source=/dev/null
. "$MYSQL_HA_ETC/secrets.env"

is_primary || exit 0

# ONLINE and PRIMARY is not sufficient on its own: a member that has lost the
# majority stays PRIMARY in its own stale view. super_read_only is what
# Group Replication clears only on a member that actually holds the write role.
[ "$(q 'SELECT @@super_read_only')" = "0" ] || exit 0

exec /usr/local/bin/colors-compute-endpoint --provider "$COMPUTE_PROVIDER" \
  --ip "$RESERVED_IP" --node-id "$NODE_UID"
