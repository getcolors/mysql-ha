# Managed by Colors mysql-ha. Non-secret node facts every agent reads.
# Credentials live in secrets.env, rclone.conf and binlog-client.cnf, none of
# which are ever rendered into the work directory.
NODE_NAME={{ inventory_hostname }}
NODE_ORDINAL={{ node_ordinal }}
NODE_HOST={{ node_host }}
PRIVATE_IP={{ private_ip }}
DROPLET_ID={{ droplet_id }}
SERVER_ID={{ server_id }}
CONNECTION_SERVER_ID={{ connection_server_id }}
MYSQL_PORT=<{ mysql-port }>
MYSQL_GROUP_PORT=<{ mysql-group-port }>
MYSQL_GROUP_NAME=<{ mysql-group-name }>
CLUSTER_HOST=<{ cluster-host }>
RESERVED_IP=<{ reserved_ip }>
BACKUP_BUCKET=<{ backup-r2-bucket }>
BACKUP_PREFIX=<{ backup-prefix }>
BACKUP_RETENTION_DAYS=<{ backup-retention-days }>
BACKUP_RESTORE_MAX_LAG_SECONDS=<{ backup-restore-max-lag-seconds }>
